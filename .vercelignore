# Upload only the source needed to build the website and usage function.
/*
!package.json
!package-lock.json
!vercel.json
!.vercelignore
!/scripts
!/scripts/**
!/src
!/src/**
!/characters
!/characters/**
!/web
!/web/**
!/api
!/api/**
!/server
!/server/**

# Keep local credentials and personal files out of uploads at any depth.
**/.env
**/.env.*
**/*.pem
**/*service-account*.json
**/persona.yaml
**/.DS_Store
